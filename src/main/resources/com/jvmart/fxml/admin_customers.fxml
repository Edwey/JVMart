<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.jvmart.controllers.AdminCustomersController"
      spacing="0" styleClass="app-root admin-page">

    <!-- Header -->
    <HBox alignment="BASELINE_LEFT" styleClass="admin-header">
        <VBox HBox.hgrow="ALWAYS" spacing="4">
            <!-- Breadcrumb -->
            <HBox spacing="6" alignment="CENTER_LEFT">
                <Label text="Management" styleClass="breadcrumb"/>
                <Label text="/" styleClass="breadcrumb"/>
                <Label text="Customer Directory" styleClass="breadcrumb-active"/>
            </HBox>
            <Label text="Customers" styleClass="admin-page-title"/>
            <Label text="Oversee your community of customers." styleClass="admin-page-subtitle"/>
        </VBox>
        <HBox spacing="12" alignment="CENTER_RIGHT">
            <StackPane>
                <TextField fx:id="searchField" promptText="Filter by name or username..." styleClass="search-bar search-bar-admin" onKeyReleased="#onSearch"/>
                <Label text="🔍" styleClass="search-icon-inline"/>
            </StackPane>
        </HBox>
    </HBox>

    <!-- Customers table -->
    <VBox spacing="0" VBox.vgrow="ALWAYS" styleClass="admin-table-container">
        <TableView fx:id="customersTable" VBox.vgrow="ALWAYS" styleClass="table-view admin-table">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="80"/>
                <TableColumn fx:id="colName" text="FULL NAME" prefWidth="180"/>
                <TableColumn fx:id="colUsername" text="USERNAME" prefWidth="140"/>
                <TableColumn fx:id="colEmail" text="EMAIL" prefWidth="220"/>
                <TableColumn fx:id="colRegistered" text="REGISTERED" prefWidth="140"/>
                <TableColumn fx:id="colOrders" text="ORDERS" prefWidth="120"/>
                <TableColumn fx:id="colActions" text="ACTIONS" prefWidth="170"/>
            </columns>
        </TableView>
        <HBox alignment="CENTER_RIGHT" spacing="8" styleClass="admin-table-footer">
            <Label fx:id="showingLabel" text="Showing 1–10 of 0 customers" styleClass="label-muted" HBox.hgrow="ALWAYS"/>
            <Button text="‹" styleClass="pagination-btn" onAction="#prevPage"/>
            <Button fx:id="page1" text="1" styleClass="pagination-btn-active"/>
            <Button fx:id="page2" text="2" styleClass="pagination-btn" onAction="#goPage2"/>
            <Button fx:id="page3" text="3" styleClass="pagination-btn" onAction="#goPage3"/>
            <Button text="›" styleClass="pagination-btn" onAction="#nextPage"/>
        </HBox>
    </VBox>
</VBox>
