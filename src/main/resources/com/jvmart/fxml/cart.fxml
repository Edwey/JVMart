<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.jvmart.controllers.CartController"
      stylesheets="@../css/jvmart-dark.css"
      spacing="0" styleClass="app-root">

    <HBox alignment="CENTER_LEFT" spacing="16" styleClass="cart-back-row">
        <Button text="← Continue Shopping" styleClass="btn-ghost-enhanced" onAction="#continueShopping"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="itemCountLabel" text="0 items" styleClass="cart-item-count"/>
    </HBox>
    <VBox spacing="8">
        <Label text="Shopping Cart" styleClass="page-title cart-title"/>
        <Label text="Review your items before checkout" styleClass="page-subtitle"/>
    </VBox>

    <HBox spacing="24" VBox.vgrow="ALWAYS" styleClass="cart-content" alignment="TOP_LEFT">
        <VBox HBox.hgrow="ALWAYS" spacing="0">
            <VBox fx:id="emptyState" alignment="CENTER" spacing="24" styleClass="cart-empty-state-enhanced" visible="false" managed="false">
                <Label text="🛒" styleClass="empty-state-icon-enhanced"/>
                <VBox spacing="8" alignment="CENTER">
                    <Label text="Your cart is empty" styleClass="empty-state-title-enhanced"/>
                    <Label text="Discover amazing products and add them to your cart" styleClass="empty-state-text-enhanced"/>
                </VBox>
                <Button text="Start Shopping" styleClass="btn-primary-enhanced" onAction="#continueShopping"/>
            </VBox>

            <VBox fx:id="filledState" spacing="0">
                <HBox styleClass="cart-header-row-enhanced">
                    <Label text="PRODUCT" styleClass="form-label-enhanced" HBox.hgrow="ALWAYS"/>
                    <Label text="PRICE" styleClass="form-label-enhanced" alignment="CENTER_RIGHT" prefWidth="120"/>
                    <Label text="QUANTITY" styleClass="form-label-enhanced" alignment="CENTER" prefWidth="120"/>
                    <Label text="TOTAL" styleClass="form-label-enhanced" alignment="CENTER_RIGHT" prefWidth="120"/>
                    <Region prefWidth="40"/>
                </HBox>

                <ScrollPane fitToWidth="true" styleClass="cart-scroll">
                    <VBox fx:id="cartItemsContainer" spacing="10" styleClass="cart-items-container"/>
                </ScrollPane>
            </VBox>
        </VBox>

        <VBox styleClass="summary-panel-enhanced" spacing="0" minWidth="280">
            <VBox spacing="8" styleClass="summary-header-enhanced">
                <Label text="Order Summary" styleClass="summary-title-enhanced"/>
                <Label text="Estimated total and shipping" styleClass="summary-subtitle-enhanced"/>
            </VBox>

            <HBox styleClass="summary-row">
                <Label text="Subtotal" styleClass="summary-label" HBox.hgrow="ALWAYS"/>
                <Label fx:id="subtotalLabel" text="GHS 0.00" styleClass="summary-value"/>
            </HBox>
            <HBox styleClass="summary-row">
                <Label text="Tax (0%)" styleClass="summary-label" HBox.hgrow="ALWAYS"/>
                <Label text="GHS 0.00" styleClass="summary-value"/>
            </HBox>
            <HBox styleClass="summary-row">
                <Label text="Shipping" styleClass="summary-label" HBox.hgrow="ALWAYS"/>
                <Label fx:id="shippingLabel" text="Free" styleClass="summary-value summary-shipping"/>
            </HBox>

            <Pane styleClass="summary-divider">
                <VBox.margin><Insets top="4" bottom="12"/></VBox.margin>
            </Pane>

            <HBox styleClass="summary-total-row" alignment="BASELINE_LEFT">
                <Label text="Total" styleClass="summary-total-label" HBox.hgrow="ALWAYS"/>
                <Label fx:id="totalLabel" text="GHS 0.00" styleClass="summary-total-value"/>
            </HBox>

            <Button fx:id="checkoutBtn" text="Proceed to checkout" styleClass="btn-primary btn-full btn-checkout" onAction="#proceedToCheckout"/>

            <Label text="Free shipping on orders over GHS 500" styleClass="form-hint cart-shipping-hint" wrapText="true"/>
        </VBox>
    </HBox>
</VBox>
