<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.jvmart.controllers.ForgotPasswordController"
           stylesheets="@../css/jvmart-dark.css"
           styleClass="app-root">

    <HBox maxWidth="900" maxHeight="560" alignment="CENTER" styleClass="login-card">

        <!-- Left dark branding panel -->
        <VBox prefWidth="340" spacing="0" styleClass="login-panel-dark">
            <VBox.margin><Insets top="0" /></VBox.margin>
            <Label styleClass="login-brand-dark" text="JVMart" />
            <Label styleClass="login-subtitle-dark" text="Editorial Archive v.1" />
            <Region VBox.vgrow="ALWAYS" />
            <Label maxWidth="260" styleClass="login-quote" text="&quot;Curating the extraordinary from the everyday.&quot;" wrapText="true" />
            <Label styleClass="login-quote-cite" text="Archive Manifest 01" />
        </VBox>

        <!-- Right form panel -->
        <VBox prefWidth="460" spacing="0" styleClass="login-form-panel">
            <VBox alignment="CENTER" spacing="8" styleClass="login-header">
                <Label styleClass="login-title" text="Reset Password" />
                <Label styleClass="login-subtitle" text="Enter your email and reset token" />
            </VBox>

            <!-- Email -->
            <Label styleClass="form-label" text="E M A I L   A D D R E S S" />
            <TextField fx:id="emailField" promptText="Enter your email address" styleClass="text-field-jv" />
            <Label fx:id="emailError" managed="false" styleClass="form-error-label" visible="false" />

            <!-- Reset Token -->
            <HBox alignment="BOTTOM_LEFT" styleClass="form-label-row">
                <Label styleClass="form-label" text="R E S E T   T O K E N" />
            </HBox>
            <TextField fx:id="tokenField" promptText="Enter your reset token" styleClass="text-field-jv" />
            <Label fx:id="tokenError" managed="false" styleClass="form-error-label" visible="false" />

            <!-- Global error -->
            <Label fx:id="resetError" managed="false" styleClass="form-error-label" visible="false" />

            <!-- Reset button -->
            <Button fx:id="resetBtn" onAction="#onReset" styleClass="btn-primary btn-full" text="Reset Password">
                <VBox.margin><Insets top="16" /></VBox.margin>
            </Button>

            <Region VBox.vgrow="ALWAYS" />

            <HBox alignment="CENTER" spacing="4" styleClass="login-footer">
                <Label styleClass="login-footer-text" text="Remember your password?" />
                <Button onAction="#onBack" styleClass="btn-link" text="Sign in" />
            </HBox>
        </VBox>
    </HBox>
</StackPane>
