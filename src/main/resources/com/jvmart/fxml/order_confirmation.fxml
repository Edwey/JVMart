<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<ScrollPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.jvmart.controllers.OrderConfirmationController"
            stylesheets="@../css/jvmart-dark.css"
            fitToWidth="true"
            styleClass="app-root transparent-scroll">

    <VBox alignment="CENTER" spacing="0" styleClass="confirmation-page">
        <padding>
            <Insets top="48" right="32" bottom="48" left="32"/>
        </padding>
        
        <StackPane alignment="CENTER" styleClass="success-icon-bg">
            <Label text="OK" styleClass="success-icon-text"/>
        </StackPane>

        <Label text="Order placed successfully!" styleClass="success-title" alignment="CENTER"/>
        <HBox alignment="CENTER" spacing="4">
            <Label text="Order ID:" styleClass="order-id-label"/>
            <Label fx:id="orderIdLabel" text="#JV-0000" styleClass="order-id-value"/>
        </HBox>

        <GridPane hgap="16" vgap="16" styleClass="confirmation-details" maxWidth="680">
            <columnConstraints>
                <ColumnConstraints percentWidth="50"/>
                <ColumnConstraints percentWidth="50"/>
            </columnConstraints>

            <VBox GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="card confirmation-card" spacing="4">
                <Label text="DELIVERY DETAILS" styleClass="form-label"/>
                <Label fx:id="customerName" text="" styleClass="confirmation-customer-name"/>
                <Label fx:id="deliveryNote" text="Cash on delivery" styleClass="confirmation-delivery-note" wrapText="true"/>
                <Label text="Expected delivery: 1-3 business days" styleClass="confirmation-delivery-time"/>
            </VBox>

            <VBox GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="card confirmation-card-alt" spacing="4">
                <Label text="PAYMENT METHOD" styleClass="form-label"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="COD" styleClass="payment-badge payment-badge-cod"/>
                    <VBox spacing="2">
                        <Label text="Cash on Delivery" styleClass="confirmation-payment-name"/>
                        <Label text="Transaction pending" styleClass="confirmation-payment-status"/>
                    </VBox>
                </HBox>
            </VBox>

            <VBox GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="2" styleClass="card confirmation-summary" spacing="0">
                <Label text="ORDER SUMMARY" styleClass="form-label confirmation-summary-title"/>
                <VBox fx:id="confirmedItemsList" spacing="10"/>

                <Pane styleClass="confirmation-divider">
                    <VBox.margin><Insets top="14" bottom="12"/></VBox.margin>
                </Pane>

                <HBox>
                    <Label text="Subtotal" styleClass="summary-label" HBox.hgrow="ALWAYS"/>
                    <Label fx:id="confirmSubtotal" text="GHS 0.00" styleClass="summary-value"/>
                </HBox>
                <HBox styleClass="confirmation-shipping-row">
                    <Label text="Shipping" styleClass="summary-label" HBox.hgrow="ALWAYS"/>
                    <Label text="Free" styleClass="summary-value summary-shipping"/>
                </HBox>
                <HBox styleClass="confirmation-total-row">
                    <Label text="Total" styleClass="summary-total-label" HBox.hgrow="ALWAYS"/>
                    <Label fx:id="confirmTotal" text="GHS 0.00" styleClass="summary-total-value"/>
                </HBox>
            </VBox>
        </GridPane>

        <HBox spacing="16" alignment="CENTER" styleClass="confirmation-actions">
            <Button text="View my orders" styleClass="btn-primary btn-view-orders" onAction="#viewOrders"/>
            <Button text="Continue shopping ->" styleClass="btn-secondary btn-continue-shopping" onAction="#continueShopping"/>
        </HBox>
    </VBox>
</ScrollPane>
