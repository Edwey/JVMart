<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import java.lang.String?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.jvmart.controllers.ProductCatalogController"
      stylesheets="@../css/jvmart-dark.css"
      spacing="0"
      styleClass="app-root">

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="transparent-scroll">
        <VBox spacing="48.0" styleClass="page-content-inner">
            <padding>
                <Insets top="48.0" right="48.0" bottom="48.0" left="48.0"/>
            </padding>

            <HBox alignment="BOTTOM_LEFT" spacing="32.0">
                <VBox spacing="20.0" HBox.hgrow="ALWAYS">
                    <Label text="The Archive" styleClass="page-title"/>
                    <Label text="Discover our curated collection of premium products" styleClass="page-subtitle"/>

                    <StackPane alignment="CENTER_LEFT" styleClass="search-bar-enhanced">
                        <TextField fx:id="searchField"
                                   promptText="Search products by name or category..."
                                   onKeyReleased="#onSearch"
                                   styleClass="search-input-enhanced"/>
                        <Label text="🔍" styleClass="search-icon-label-enhanced" StackPane.alignment="CENTER_LEFT"/>
                    </StackPane>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <VBox spacing="12.0" alignment="BOTTOM_RIGHT">
                    <HBox alignment="CENTER" spacing="12.0">
                        <Label text="Sort by:" styleClass="sort-label"/>
                        <ComboBox fx:id="sortCombo"
                                  onAction="#onSort"
                                  styleClass="sort-combo-enhanced">
                            <items>
                                <FXCollections fx:factory="observableArrayList">
                                    <String fx:value="Newest"/>
                                    <String fx:value="Price: Low to High"/>
                                    <String fx:value="Price: High to Low"/>
                                    <String fx:value="Name: A-Z"/>
                                </FXCollections>
                            </items>
                        </ComboBox>
                    </HBox>
                    
                    <HBox alignment="CENTER" spacing="8.0">
                        <Button text="🔧 Filters"
                                onAction="#showFilterHelp"
                                styleClass="btn-filter"/>
                        <Button text="⟳ Refresh"
                                onAction="#refreshProducts"
                                styleClass="btn-refresh"/>
                    </HBox>
                </VBox>
            </HBox>

            <VBox fx:id="productsContainer" spacing="24.0">
                <FlowPane fx:id="productGrid"
                          hgap="24.0"
                          vgap="24.0"
                          prefWrapLength="1200.0"/>
                
                <HBox fx:id="loadingIndicator" alignment="CENTER" spacing="16" visible="false" managed="false" styleClass="loading-container">
                    <Label text="Loading" styleClass="loading-text"/>
                    <Label text="⏳" styleClass="loading-spinner"/>
                </HBox>
                
                <VBox fx:id="emptyState" alignment="CENTER" spacing="16" visible="false" managed="false" styleClass="empty-state-enhanced">
                    <Label text="📦" styleClass="empty-state-icon-enhanced"/>
                    <Label text="No products found" styleClass="empty-state-title-enhanced"/>
                    <Label text="Try adjusting your search or filters" styleClass="empty-state-text-enhanced"/>
                    <Button text="Clear Filters" styleClass="btn-primary" onAction="#clearFilters"/>
                </VBox>
            </VBox>

            <Region prefHeight="80.0"/>
        </VBox>
    </ScrollPane>
</VBox>
