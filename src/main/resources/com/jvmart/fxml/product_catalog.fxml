<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import java.lang.String?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.jvmart.controllers.ProductCatalogController"
      stylesheets="@../css/jvmart-dark.css"
      spacing="0"
      styleClass="app-root">

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="transparent-scroll">
        <VBox spacing="48.0" styleClass="page-content-inner">
            <padding>
                <Insets top="48.0" right="48.0" bottom="48.0" left="48.0"/>
            </padding>

            <HBox alignment="BOTTOM_LEFT" spacing="24.0">
                <VBox spacing="16.0" HBox.hgrow="ALWAYS">
                    <Label text="The Archive" styleClass="page-title"/>

                    <StackPane alignment="CENTER_LEFT" styleClass="search-bar">
                        <TextField fx:id="searchField"
                                   promptText="Search curated products..."
                                   onKeyReleased="#onSearch"
                                   styleClass="search-input"/>
                        <Label text="🔍" styleClass="search-icon-label" StackPane.alignment="CENTER_LEFT"/>
                    </StackPane>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <HBox alignment="BOTTOM_RIGHT" spacing="16.0">
                    <ComboBox fx:id="sortCombo"
                              onAction="#onSort"
                              styleClass="sort-combo">
                        <items>
                            <FXCollections fx:factory="observableArrayList">
                                <String fx:value="Newest"/>
                                <String fx:value="Price: Low to High"/>
                                <String fx:value="Price: High to Low"/>
                                <String fx:value="Name: A-Z"/>
                            </FXCollections>
                        </items>
                    </ComboBox>

                    <Button text="Sidebar Filters"
                            onAction="#showFilterHelp"
                            styleClass="btn-dark"/>
                </HBox>
            </HBox>

            <FlowPane fx:id="productGrid"
                      hgap="32.0"
                      vgap="32.0"
                      prefWrapLength="1000.0"/>

            <Region prefHeight="60.0"/>
        </VBox>
    </ScrollPane>
</VBox>
