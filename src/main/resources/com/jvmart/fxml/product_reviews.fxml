<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.jvmart.controllers.ProductReviewsController"
      spacing="0"
      styleClass="app-root">

    <HBox alignment="CENTER_LEFT" spacing="16" styleClass="cart-back-row">
        <Button text="← Back to product" styleClass="btn-ghost-enhanced" onAction="#back"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="titleLabel" text="Reviews" styleClass="page-title"/>
    </HBox>

    <VBox spacing="8">
        <Label fx:id="subtitleLabel" text="" styleClass="page-subtitle"/>
    </VBox>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="transparent-scroll">
        <VBox fx:id="list" spacing="12" styleClass="reviews-list">
            <padding><Insets top="12" right="0" bottom="24" left="0"/></padding>
        </VBox>
    </ScrollPane>
</VBox>

