<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.jvmart.controllers.WishlistController"
      spacing="0"
      styleClass="app-root">

    <HBox alignment="CENTER_LEFT" spacing="16" styleClass="cart-back-row">
        <Button text="← Back" styleClass="btn-ghost-enhanced" onAction="#back"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Clear Wishlist" styleClass="btn-outline" onAction="#clearWishlist"/>
    </HBox>

    <VBox spacing="8">
        <Label text="Wishlist" styleClass="page-title cart-title"/>
        <Label fx:id="countLabel" text="0 items saved" styleClass="page-subtitle"/>
    </VBox>

    <StackPane VBox.vgrow="ALWAYS">
        <VBox fx:id="emptyState" alignment="CENTER" spacing="16" visible="false" managed="false" styleClass="empty-state-enhanced">
            <Label text="💾" styleClass="empty-state-icon-enhanced"/>
            <Label text="No saved items yet" styleClass="empty-state-title-enhanced"/>
            <Label text="Save products to see them here." styleClass="empty-state-text-enhanced"/>
            <Button text="Browse Products" styleClass="btn-primary-enhanced" onAction="#browseProducts"/>
        </VBox>

        <ScrollPane fx:id="scroll" fitToWidth="true" hbarPolicy="NEVER" styleClass="transparent-scroll">
            <VBox fx:id="itemsBox" spacing="12" styleClass="wishlist-list">
                <padding><Insets top="12" right="0" bottom="24" left="0"/></padding>
            </VBox>
        </ScrollPane>
    </StackPane>
</VBox>

