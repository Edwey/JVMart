<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>
<BorderPane prefHeight="900.0" prefWidth="1440.0" styleClass="app-root" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1">

    <!-- TOP NAVIGATION BAR -->
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="80.0" styleClass="top-bar">
            <padding>
                <Insets left="32.0" right="32.0" />
            </padding>

            <!-- Logo Area -->
            <HBox alignment="CENTER_LEFT" spacing="32.0">
                <Label styleClass="brand-title" text="J V M A R T" />

                <!-- Center Navigation Links -->
                <HBox alignment="CENTER" spacing="32.0">
                    <Label styleClass="nav-link" text="Home" />
                    <VBox alignment="CENTER" spacing="4.0" styleClass="nav-link-active">
                        <Label styleClass="nav-link-text-active" text="Products" />
                        <Region prefHeight="2.0" styleClass="nav-link-underline" />
                    </VBox>
                    <Label styleClass="nav-link" text="My Orders" />
                </HBox>
            </HBox>

            <Region HBox.hgrow="ALWAYS" />

            <!-- Right Icons & Profile -->
            <HBox alignment="CENTER" spacing="20.0">
                <!-- Shopping Cart with Notification Badge -->
                <StackPane styleClass="icon-btn">
                    <SVGPath content="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49c.08-.14.12-.31.12-.48 0-.55-.45-1-1-1H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z" styleClass="icon-svg" />
                    <Label styleClass="cart-badge" text="3" translateX="8.0" translateY="-8.0" />
                </StackPane>

                <!-- Dark Mode -->
                <StackPane styleClass="icon-btn">
                    <SVGPath content="M12 3c-4.97 0-9 4.03-9 9s4.03 9 9 9 9-4.03 9-9c0-.46-.04-.92-.1-1.36-.98 1.37-2.58 2.26-4.4 2.26-2.98 0-5.4-2.42-5.4-5.4 0-1.81.89-3.42 2.26-4.4-.44-.06-.9-.1-1.36-.1z" styleClass="icon-svg" />
                </StackPane>

                <!-- Notifications -->
                <StackPane styleClass="icon-btn">
                    <SVGPath content="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2zm6-6v-5c0-3.07-1.63-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.64 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2zm-2 1H8v-6c0-2.48 1.51-4.5 4-4.5s4 2.02 4 4.5v6z" styleClass="icon-svg" />
                </StackPane>

                <!-- Divider -->
                <Region prefWidth="1.0" prefHeight="40.0" styleClass="nav-divider" />

                <!-- User Profile -->
                <HBox alignment="CENTER" spacing="12.0" styleClass="user-profile">
                    <VBox alignment="CENTER_RIGHT">
                        <Label styleClass="user-name" text="Alex Sterling" />
                        <Label styleClass="user-role" text="P R E M I U M   M E M B E R" />
                    </VBox>
                    <StackPane styleClass="user-avatar-container">
                        <Circle fill="#cfc4c6" radius="18.0" />
                    </StackPane>
                </HBox>
            </HBox>
        </HBox>
    </top>

    <!-- SIDE NAVIGATION BAR -->
    <left>
        <VBox prefWidth="256.0" styleClass="sidebar" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="32.0" top="32.0" />
            </padding>

            <VBox spacing="4.0">
                <padding>
                    <Insets bottom="32.0" left="24.0" right="24.0" />
                </padding>
                <Label styleClass="sidebar-title" text="Categories" />
                <Label styleClass="sidebar-subtitle" text="C U R A T E D   C O L L E C T I O N S" />
            </VBox>

            <!-- Navigation Links -->
            <VBox spacing="4.0">
                <!-- Active Category: All Products -->
                <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="sidebar-item-active">
                    <padding>
                        <Insets bottom="12.0" left="20.0" top="12.0" />
                    </padding>
                    <SVGPath content="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z" styleClass="sidebar-icon sidebar-icon-active" />
                    <Label styleClass="sidebar-item-label-active" text="All Products" />
                </HBox>

                <!-- Inactive Categories -->
                <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="sidebar-item">
                    <padding>
                        <Insets bottom="12.0" left="24.0" top="12.0" />
                    </padding>
                    <SVGPath content="M4 6h18V4H4c-1.1 0-2 .9-2 2v11H0v3h14v-3H4V6zm20-2h-8c-.55 0-1 .45-1 1v15c0 .55.45 1 1 1h8c.55 0 1-.45 1-1V5c0-.55-.45-1-1-1zm-1 14h-6V6h6v12z" styleClass="sidebar-icon" />
                    <Label styleClass="sidebar-item-label" text="Electronics" />
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="sidebar-item">
                    <padding>
                        <Insets bottom="12.0" left="24.0" top="12.0" />
                    </padding>
                    <SVGPath content="M21.99 8c0-.72-.37-1.35-.94-1.7L16 3h-3.23c-.36 1.19-1.46 2-2.77 2s-2.41-.81-2.77-2H4L.95 6.3C.38 6.65 0 7.28 0 8v2h3v11h18V10h3V8z" styleClass="sidebar-icon" />
                    <Label styleClass="sidebar-item-label" text="Clothing" />
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="sidebar-item">
                    <padding>
                        <Insets bottom="12.0" left="24.0" top="12.0" />
                    </padding>
                    <SVGPath content="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z" styleClass="sidebar-icon" />
                    <Label styleClass="sidebar-item-label" text="Home &amp; Living" />
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="sidebar-item">
                    <padding>
                        <Insets bottom="12.0" left="24.0" top="12.0" />
                    </padding>
                    <SVGPath content="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-5h2v5zm4 0h-2v-3h2v3zm0-5h-2v-2h2v2zm4 5h-2V7h2v10z" styleClass="sidebar-icon" />
                    <Label styleClass="sidebar-item-label" text="Editorial" />
                </HBox>
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <!-- Member Perk Card -->
            <VBox styleClass="sidebar-promo">
                <VBox.margin>
                    <Insets left="24.0" right="24.0" />
                </VBox.margin>
                <Label styleClass="sidebar-promo-title" text="M E M B E R   P E R K" />
                <Label wrapText="true" styleClass="sidebar-promo-text" text="Get free shipping on orders over GH₵ 500." />
            </VBox>
        </VBox>
    </left>

    <!-- MAIN CONTENT AREA -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="transparent-scroll">
            <VBox spacing="48.0" styleClass="page-content">
                <padding>
                    <Insets bottom="48.0" left="48.0" right="48.0" top="48.0" />
                </padding>

                <!-- Page Header, Search & Filters -->
                <HBox alignment="BOTTOM_LEFT" spacing="24.0">
                    <VBox spacing="16.0" HBox.hgrow="ALWAYS">
                        <Label styleClass="page-title" text="The Archive" />

                        <!-- Search Bar -->
                        <StackPane alignment="CENTER_LEFT" styleClass="search-bar">
                            <TextField promptText="Search curated products..." styleClass="search-input" />
                            <SVGPath content="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" styleClass="search-icon" translateX="16" />
                        </StackPane>
                    </VBox>

                    <Region HBox.hgrow="ALWAYS" />

                    <HBox alignment="BOTTOM_RIGHT" spacing="16.0">
                        <!-- Sort Dropdown (Mocked as Button) -->
                        <HBox alignment="CENTER" spacing="12.0" styleClass="sort-dropdown-mock">
                            <Label styleClass="sort-dropdown-text" text="Sort: Newest" />
                            <SVGPath content="M16.59 8.59L12 13.17 7.41 8.59 6 10l6 6 6-6z" styleClass="sort-dropdown-icon" />
                        </HBox>

                        <!-- Filters Button -->
                        <Button styleClass="btn-filters">
                            <graphic>
                                <HBox alignment="CENTER" spacing="8.0">
                                    <SVGPath content="M10 18h4v-2h-4v2zM3 6v2h18V6H3zm3 7h12v-2H6v2z" styleClass="btn-filters-icon" />
                                    <Label styleClass="btn-filters-text" text="Filters" />
                                </HBox>
                            </graphic>
                        </Button>
                    </HBox>
                </HBox>

                <!-- Product Grid Area (FlowPane for responsive wrapping) -->
                <FlowPane hgap="32.0" vgap="32.0" prefWrapLength="1000.0">
                    <!-- Product cards would be dynamically generated here -->
                </FlowPane>

                <Region prefHeight="60.0" />
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
